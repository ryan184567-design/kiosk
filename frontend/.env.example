# 正式服務 (npm start) 設定

# 監聽位址
#   0.0.0.0   = 監聽所有網卡（本機與其他電腦皆可連線）
#   127.0.0.1 = 只允許本機連線
#   指定 IP   = 只監聽該網卡，例如 192.168.0.115
HOST=0.0.0.0

# 埠號
PORT=3000

# 對外訪問用的主機 IP 或網域（僅用於啟動時顯示訪問網址）
# 留空則自動列出本機所有 IP，例如：PUBLIC_HOST=192.168.0.115
PUBLIC_HOST=

# 本檔所有設定皆可在櫃台螢幕（/staff）右上角「系統設定」修改（會直接寫回此檔，原檔備份為 .env.bak）

# 前端設定（VITE_ 開頭；正式服務於執行時讀取，畫面重新整理即生效，不需重新 build）
# 訪客機無操作多少秒後自動清除資料並回到首頁
VITE_IDLE_SECONDS=120

# 有預約的速通碼長度（數字；QR Code 的內容即為速通碼）
VITE_PASS_CODE_LENGTH=10

# Debug 模式：true 時會將各流程取得的資訊（API 參數/結果、頁面切換、操作）輸出到瀏覽器 console
# 正式上線請設為 false（資料可能含個人資料）
VITE_DEBUG=false

# 記錄檔（格式仿 Laravel）：logs/visitor-YYYY-MM-DD.log，每天一個檔案
# 等級：debug < info < warning < error
# VITE_LOG_LEVEL  前端送到伺服器寫檔的最低等級（off = 不送）
# LOG_LEVEL       伺服器寫入檔案的最低等級（含前端送來的記錄）
# LOG_DAYS        記錄檔保留天數
VITE_LOG_LEVEL=info
LOG_LEVEL=info
LOG_DAYS=14

# Kiosk 瀏覽器（開機登入後自動全螢幕開啟訪客機畫面，見 README）
# KIOSK_URL     開啟的網址，留空 = http://localhost:<PORT>
# KIOSK_BROWSER auto（Chrome 優先）| chrome | edge | chromium | 瀏覽器執行檔完整路徑
KIOSK_URL=
KIOSK_BROWSER=auto
# KIOSK_MODE            dual = 雙螢幕（訪客畫面 + 櫃台畫面 /staff）| single = 只開訪客畫面
# KIOSK_VISITOR_DISPLAY 訪客畫面所在螢幕（由左到右 1、2…）
# KIOSK_STAFF_DISPLAY   櫃台畫面所在螢幕
KIOSK_MODE=dual
KIOSK_VISITOR_DISPLAY=1
KIOSK_STAFF_DISPLAY=2

# 櫃台螢幕（/staff）「系統設定」的修改權限
#   有設定 → 任何電腦輸入此 PIN 即可修改
#   留空   → 只允許在本機（localhost）修改
SETTINGS_PIN=

# POS 印表機（熱感應出單機，ESC/POS 指令）列印訪客證；測試：npm run print:test# PRINTER_TYPE  mock = 不實際列印（內容存到 logs/print-last.*）
#               usb  = USB 印表機（Windows：列印佇列 RAW 模式；Linux：/dev/usb/lp0）
#               device = 直接寫入裝置，使用 PRINTER_DEVICE（Windows 可填 COM 埠，例 COM9）
#               cups = Linux CUPS ｜ network = 網路印表機
# PRINTER_NAME                  usb（Windows）/ cups：印表機名稱，用 npm run print:list 查詢（Windows 留空 = 預設印表機）
# PRINTER_DEVICE                device：Windows 填 COM 埠（例 COM9）；Linux 裝置檔，預設 /dev/usb/lp0
# PRINTER_HOST / PRINTER_PORT   network 使用，例 192.168.0.200 / 9100
# PRINTER_ENCODING              中文編碼：big5（繁中）| gb18030（簡中機型）
# PRINTER_PAPER_WIDTH           紙寬 mm：80 | 58
# PRINTER_QR_SIZE               QR Code 大小 1~16
# PRINTER_QR_MODE               image = 點陣圖列印（預設，所有機型可用）| native = 印表機內建 QR 指令（部分機型不支援，印不出 QR 時請用 image）
PRINTER_TYPE=mock
PRINTER_NAME=
PRINTER_DEVICE=
PRINTER_HOST=
PRINTER_PORT=9100
PRINTER_ENCODING=big5
PRINTER_CHINESE_MODE=true
PRINTER_PAPER_WIDTH=80
PRINTER_QR_SIZE=8
PRINTER_QR_MODE=image
PRINTER_TITLE=訪客證

# 證件掃描器（Plustek WebFXScan，身份驗證步驟插入證件即自動掃描辨識）；測試：npm run idcard:test
# SCANNER_TYPE            mock = 模擬（回傳範例資料）| plustek = Plustek WebFXScan 服務
#                         使用 plustek 前需安裝 PlustekSDK_LDSetup 與掃描器驅動程式（服務預設 ws://127.0.0.1:17778/webscan2）
# SCANNER_DEVICE          裝置名稱，留空 = 第一台
# SCANNER_SOURCE          掃描來源，留空 = 依裝置能力自動選擇（例 Camera〔A61~A64〕、Sheetfed-Front）
# SCANNER_RECOGNIZE_TYPE  twid = 台灣身分證 | passport = 護照 | auto
# SCANNER_TIMEOUT         單次掃描逾時秒數
# SCANNER_POLL_INTERVAL   攝影機式掃描器（Camera，例 A62）等待證件時的試掃間隔（毫秒，500~10000）
# ※ 證號只保存遮罩後的值（A123****89），不會寫入完整證號
# ※ 掃描服務同時只能給一個程式使用：使用 kiosk 時請關閉瀏覽器中的 Plustek SDK 範例頁
SCANNER_TYPE=mock
SCANNER_HOST=127.0.0.1
SCANNER_PORT=17778
SCANNER_DEVICE=
SCANNER_SOURCE=
SCANNER_RECOGNIZE_TYPE=twid
SCANNER_TIMEOUT=30
SCANNER_POLL_INTERVAL=1500

APP_NAME=WebBase
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=zh_TW
APP_FAKER_LOCALE=zh_TW

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# 見 README 4.2.2、config/cors.php：CORS 明確白名單，逗號分隔多個網域，
# 例如 https://admin.example.com,https://shop.example.com。正常情況下
# Vue3 SPA／Blade 與 API 同來源，不需要設定；本機開發 Vue dev server 的
# 跨來源需求是靠 vite.vue.config.js 的 proxy 解決（見下方
# VUE_DEV_API_PROXY），不算在這份白名單管轄範圍內。
CORS_ALLOWED_ORIGINS=

# 見 vite.vue.config.js：npm run vue:dev 時 Vite dev server 把 /api 轉發到
# 這個位址，預設對應 php artisan serve 的預設位址，不需要另外設定。
# VUE_DEV_API_PROXY=http://127.0.0.1:8000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# 每天一個日誌檔（storage/logs/laravel-YYYY-MM-DD.log），只保留 LOG_DAILY_DAYS 天
LOG_STACK=daily
LOG_DAILY_DAYS=15
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=base_hq
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_ENGINE=InnoDB

# 建站流程專用高權限帳號（見 README 6.3 安全性提醒），未設定時回退用上面的 DB_USERNAME/PASSWORD
# DB_PROVISION_USERNAME=
# DB_PROVISION_PASSWORD=

# 讀寫分離（可選，見 README 2.5）
# DB_READ_HOST=
# DB_WRITE_HOST=
# DB_STICKY=true

# 多租戶（多站，見 README 6.1）：開發/SaaS 預設 true；單站部署匯出包固定 false，見 6.8
MULTI_SITE_ENABLED=true

# 子站資料庫命名前綴，見 README 6.3：資料庫名固定為 {prefix}{site.code}
SITE_DB_PREFIX=base_site_

# 單站模式專用（MULTI_SITE_ENABLED=false 時才需要，見 6.8 第 3 點）
# SITE_TEMPLATE_NAMESPACE 是客製化覆寫的識別碼；SITE_ID 是這個部署包固化的
# 站點編號（由 site:package 寫入原本在多站環境下的 site_id，不是固定 1），
# 用來對應資料庫內以 site_id 標記的既有資料，見 6.8。
# SITE_TEMPLATE_NAMESPACE=
# SITE_ID=

# 初始帳號定義（見 config/initial_accounts.php、README 6.3/6.12）。
# 登入一律用帳號（username）+密碼，不使用 email。密碼沒設定會在 seed 時直接報錯中斷，
# 不會隨機產生，因為這些是我方內部固定帳號，不是每站各自一組。
# HQ_ADMIN_USERNAME=admin
HQ_ADMIN_PASSWORD=

# SITE_SUPER_ADMIN_USERNAME=admin
SITE_SUPER_ADMIN_PASSWORD=
# SITE_DELEGATION_ROOT_USERNAME 不填時預設用該子站自己的代號（例如 code=vendora 對應 username=vendora），見 config/initial_accounts.php
SITE_DELEGATION_ROOT_PASSWORD=

# JWT（見 README 11.1）。SITE/HQ 兩把密鑰各自獨立、不可共用，正式環境務必
# 各自改成自己產生的隨機值（php -r "echo bin2hex(random_bytes(32));"）
JWT_TTL_MINUTES=120
JWT_SITE_SECRET=
JWT_HQ_SECRET=
# 廠商模式（App Token）JWT 密鑰（至少 32 字元，獨立於上面兩把與 APP_KEY）；機器接口換 token 必填
FACTORY_JWT_SECRET=
# 廠商模式記錄：每個區塊的上限（bytes）、保留天數（超過自動移除）、自動清理排程
FACTORY_LOG_MAX_BYTES=65536
FACTORY_LOG_RETENTION_DAYS=30
FACTORY_LOG_PRUNE_ENABLED=true
FACTORY_LOG_PRUNE_TIME=03:40
JWT_SINGLE_USER_SESSION=true
JWT_SESSION_TOUCH_INTERVAL_SECONDS=60
JWT_SESSION_PRUNE_ENABLED=true
JWT_SESSION_PRUNE_RETENTION_DAYS=30
JWT_SESSION_PRUNE_TIME=03:20

# 信任的反向代理來源（見 README 4.2.2），本機留空即可
# TRUSTED_PROXIES=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
